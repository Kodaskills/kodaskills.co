---
import Benefit from "@components/blocks/Benefit.astro";
import ConversionSection from "@components/blocks/ConversionSection.astro";
import PageHeader from "@components/blocks/PageHeader.astro";
import PageHero from "@components/blocks/PageHero.astro";
import Playbook from "@components/blocks/Playbook.astro";
import Process from "@components/blocks/Process.astro";
import Button from "@components/primitives/Button.astro";
import Icon from "@components/primitives/Icon.astro";
import Text from "@components/typography/Text.astro";
import { useI18n } from "@i18n/index";
import BaseLayout from "@layouts/BaseLayout.astro";

export function getStaticPaths() {
  return [{ params: { locale: undefined } }, { params: { locale: "fr" } }];
}

const { _, lp } = await useI18n(Astro.currentLocale);
---

<BaseLayout
  title={_("KODASKILLS | Fractional CTO & Senior Tech Advisory")}
  activePage="home"
>
  <PageHero>
    <PageHeader
      badge={_("20+ YEARS OPERATIONAL EXPERIENCE")}
      badges={[_("OPEN CORE METHODOLOGY"), _("FRACTIONAL, NOT FREELANCE")]}
    >
      <Fragment slot="title">
        {_("Stop Outsourcing")}.<br />
        <span class="text-primary">{_("Start Augmenting.")}</span><br />
      </Fragment>
      <Fragment slot="description">
        {_("Fractional CTO and Elite Engineering. We embed senior technical leadership to ")}
        <span class="text-primary font-semibold"
          >{_("de-risk your roadmap")}</span>
        {_("and accelerate delivery.")}
      </Fragment>
    </PageHeader>

    <nav class="flex flex-wrap gap-4 pt-4" aria-label="Page actions">
      <Button href={lp("/contact")} size="md">
        <Icon name="cta-rocket" />
        {_("Request Technical Assessment")}
      </Button>
      <Button href={lp("/approach")} variant="outlined" size="md">
        {_("View Open Source Framework")}
        <Icon name="cta-arrow" size={16} class="ml-2" />
      </Button>
    </nav>

    <address
      class="absolute bottom-12 right-12 hidden xl:block text-right not-italic"
    >
      <Text variant="xs" class="font-mono text-outline-variant mb-2"
        >{_("COORDINATES_LOC")}</Text
      >
      <output class="text-sm font-mono text-on-surface-variant tracking-widest"
        >52.3676° N, 4.9041° E</output
      >
    </address>
  </PageHero>

  <Playbook
    title={_("A Playbook For Technical Founders")}
    description={_("De-risk, build, and scale with a unified architectural vision.")}
    items={[
      {
        number: "01",
        title: _("Technical Forensics"),
        description: _("We do not just audit we perform a deep structural autopsy identifying critical points before they manifest as downtime.")
      },
      {
        number: "02",
        title: _("Platform Engineering"),
        description: _("Infrastructure as an enabler. We build Zero-Trust systems that scale horizontally without human intervention.")
      },
      {
        number: "03",
        title: _("AI & Growth Enablement"),
        description: _("Transforming raw data into operational leverage through bespoke LLM implementations and autonomous workflows.")
      }
    ]}
    ctaTitle={_("KNOWLEDGE TRANSFER GUARANTEED")}
    ctaSubtitle={_("You own :")}
    subItems={[_("The IP"), _("The code"), _("The runbooks")]}
    ctaFinal={_("No vendor lock-in")}
  />

  <Benefit
    title={_("Deploy with confidence.Scale without limits.")}
    description={_("We embed senior fractional CTO leadership to transform your infrastructure from a bottleneck into a competitive advantage.")}
    stats={[
      {
        label: _("Qualitative code"),
        value: _("0 Critical incidents"),
        description: _("Related to our infrastructure module")
      },
      {
        label: _("certification"),
        value: _("X/10 OpenSSF Score"),
        description: _("Ensuring a secure, production-ready foundation")
      }
    ]}
    figureLabel={_("System Schema")}
  />

  <Process
    subtitle={_("Methodology")}
    title={_("Strategic Implementation Protocol")}
    steps={[
      {
        number: "01",
        title: _("Forensics"),
        description: _("Deep analysis of existing infrastructure and codebase. We find the skeletons before they find you."),
        phase: _("Diagnosis")
      },
      {
        number: "02",
        title: _("Architecture Review"),
        description: _("Stress-testing the vision against scalability requirements. Validating every assumption in the stack."),
        phase: _("Blueprint")
      },
      {
        number: "03",
        title: _("The 90-Day Sprint"),
        description: _("Rapid implementation of the core architectural changes. Zero-downtime migrations and clean-room deploys."),
        phase: _("Execution")
      },
      {
        number: "04",
        title: _("Knowledge Transfer"),
        description: _("Upskilling internal teams to own the new stack. We aren't successful until you don't need us daily."),
        phase: _("Autonomy")
      },
      {
        number: "05",
        title: _("Guardian SLA"),
        description: _("Continuous oversight and quarterly strategic pivot. We remain on-call for your most critical architectural decisions."),
        phase: _("Oversight")
      },
    ]}
  />

  <ConversionSection
    title={_("A single, focused conversation.No strings attached.")}
    description={_("Most firms hide behind forms and automated sequences. We start with a 30-minute technical discussion focused entirely on your current challenge.")}
    steps={[
      { number: "1", label: _("You share context") },
      { number: "2", label: _("We discuss technical options") },
      { number: "3", label: _("You decide if we're useful.") },
    ]}
    buttonLabel={_("Book a Technical Discussion")}
    contactUrl={lp("/contact")}
    linkLabel={_("or if you prefer the old way")}
    footerText={_("We reply personally within 48h. No automated drip campaigns.")}
  />
</BaseLayout>

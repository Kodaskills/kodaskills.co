---
import Icon from "@components/primitives/Icon.astro";
import Text from "@components/typography/Text.astro";
import Title from "@components/typography/Title.astro";
import type { IconName } from "@lib/icons";

interface Props {
  title: string;
  description: string;
  items: { number: string; title: string; description: string }[];
  ctaTitle: string;
  ctaSubtitle: string;
  subItems: string[];
  ctaFinal: string;
  class?: string;
}

const {
  title,
  description,
  items,
  ctaTitle,
  ctaSubtitle,
  subItems,
  ctaFinal,
  class: className,
} = Astro.props;
---

<section class="bg-surface-container-low py-24 px-6 md:px-12 reveal-on-scroll">
  <div class="max-w-7xl mx-auto">
    <header class="text-center mb-24">
      <Title as="h2" variant="display" class="mb-6">
        {title}
      </Title>
      <Text variant="lg" class="text-on-surface-variant max-w-3xl mx-auto">
        {description}
      </Text>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
      <figure class="flex flex-col items-center md:items-start">
        <div
          class="w-4/5 md:w-80 lg:w-[400px] aspect-square blueprint-x relative spotlight transition-all duration-300 hover:scale-102 shadow-xl shadow-black/5 parallax-bg"
          data-alt="Technical system architecture diagram placeholder."
          id="architecture-img"
          style="display: flex !important; align-items: center !important; justify-content: center !important;"
        >
          <Icon name="architecture" size={48} class="text-outline-variant" />
        </div>
        <figcaption class="mt-6">
          <Text
            variant="captionMono"
            class="text-primary font-bold uppercase tracking-[0.3em]"
          >
            SYSTEM ARCHITECTURE V2.05
          </Text>
        </figcaption>
      </figure>

      <article class="space-y-12">
        {
          items.map((item) => (
            <article class="flex gap-8 items-start hover-card-premium">
              <Title
                as="span"
                variant="headline"
                class="text-outline-variant font-headline font-bold leading-none pt-1 inline-block text-center"
              >
                {item.number}
              </Title>
              <div>
                <Title
                  as="h3"
                  variant="h3"
                  class="font-headline font-bold tracking-tight mb-3"
                >
                  {item.title}
                </Title>
                <Text
                  variant="lg"
                  class="text-on-surface-variant leading-relaxed"
                >
                  {item.description}
                </Text>
              </div>
            </article>
          ))
        }
      </article>
    </div>

    <aside class="mt-24 p-10 bg-surface">
      <div class="w-full flex flex-col gap-10 items-center text-center">
        <div class="flex gap-4 flex-col items-center">
          <Icon
            name="verified-user"
            size={48}
            class="text-on-inverse-surface"
          />
          <div>
            <Title
              as="h3"
              variant="h2"
              class="font-headline font-bold uppercase text-on-inverse-surface"
            >
              {ctaTitle}
            </Title>
            <Text variant="lg" class="font-medium mt-4 text-on-inverse-surface">
              {ctaSubtitle}
            </Text>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full">
          {
            subItems.map((subItem) => (
              <article class="border border-outline-variant p-8 bg-surface-container-high">
                <Title
                  as="h4"
                  variant="h4"
                  class="font-headline font-bold tracking-tight"
                >
                  {subItem}
                </Title>
              </article>
            ))
          }
        </div>
        <div>
          <Title
            as="p"
            variant="h4"
            class="font-headline font-bold uppercase tracking-[0.2em] text-on-inverse-surface"
          >
            {ctaFinal}
          </Title>
        </div>
      </div>
    </aside>
  </div>
</section>

---
import Button from "@components/primitives/Button.astro";
import Text from "@components/typography/Text.astro";
import Title from "@components/typography/Title.astro";

interface Props {
  title: string;
  description: string;
  steps: { number: string; label: string }[];
  buttonLabel: string;
  contactUrl: string;
  linkLabel: string;
  footerText: string;
  class?: string;
}

const {
  title,
  description,
  steps,
  buttonLabel,
  contactUrl,
  linkLabel,
  footerText,
  class: className,
} = Astro.props;
---

<section class="py-40 px-6 md:px-12 text-center max-w-6xl mx-auto reveal-on-scroll">
  <header class="mb-10">
    <Title as="h2" variant="headline" class="font-headline font-bold">
      {title}
    </Title>
  </header>
  <Text variant="lg" class="text-on-surface-variant mb-20 leading-relaxed">
    {description}
  </Text>
  <nav class="flex flex-col md:flex-row items-center justify-between gap-12 mb-24" aria-label="Process steps">
    {steps.map((step, index) => (
      <>
        <div class="flex-1 px-6">
          <Title as="p" variant="h2" class="font-headline font-bold mb-4">{step.number}.</Title>
          <Title as="p" variant="h4" class="font-headline font-bold">{step.label}</Title>
        </div>
        {index < steps.length - 1 && (
          <hr class="hidden md:block w-20 h-px bg-outline-variant" />
        )}
      </>
    ))}
  </nav>
  <div class="mb-8">
    <Button href={contactUrl} size="lg">
      {buttonLabel}
    </Button>
  </div>
  <footer>
    <a class="text-base font-headline font-bold text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center gap-2 mb-6" href={contactUrl}>
      {linkLabel} <span class="text-2xl leading-none mt-0.5">→</span>
    </a>
    <Text variant="sm" class="text-on-surface-variant italic">
      {footerText}
    </Text>
  </footer>
</section>